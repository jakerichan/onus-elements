{
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "default": [
      "sharedGlobals"
    ]
  },
  "generators": {
    "@nx/angular:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "css"
    },
    "@nx/react": {
      "application": {
        "style": "css",
        "linter": "eslint",
        "bundler": "webpack",
        "unitTestRunner": "jest",
        "babel": true
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "none",
        "linter": "eslint",
        "unitTestRunner": "jest",
        "compiler": "babel",
        "format": "esm,umd,cjs"
      }
    }
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "release": {
      "dependsOn": [
        "^release"
      ]
    },
    "e2e": {
      "cache": true
    },
    "@nx/jest:jest": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.cjs"
      ],
      "cache": true,
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "@nx/eslint:lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.js"
      ],
      "cache": true
    },
    "@nx/rollup:rollup": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ]
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "defaultProject": "onus-react",
  "useInferencePlugins": false,
  "defaultBase": "main"
}
