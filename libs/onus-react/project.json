{
  "name": "onus-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/onus-react/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "libs/onus-react/dist",
        "tsConfig": "libs/onus-react/tsconfig.lib.json",
        "project": "libs/onus-react/package.json",
        "entryFile": "libs/onus-react/src/index.ts",
        "external": [
          "react/jsx-runtime"
        ],
        "rollupConfig": "@nx/react/plugins/bundle-rollup",
        "compiler": "swc",
        "format": [
          "esm",
          "cjs"
        ],
        "assets": [
          {
            "glob": "libs/onus-react/README.md",
            "input": ".",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx}",
          "libs/onus-react/package.json"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit"
        ],
        "cwd": "{projectRoot}",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/onus-react/jest.config.ts"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "npx semantic-release --extends ./libs/onus-react/release.config.js ",
        "parallel": false
      }
    }
  }
}
