{
  "name": "onus-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/onus-core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "main": "libs/onus-core/src/index.ts",
        "outputPath": "libs/onus-core/dist",
        "tsConfig": "libs/onus-core/tsconfig.lib.json",
        "compiler": "tsc",
        "project": "libs/onus-core/package.json",
        "external": [],
        "format": [
          "cjs",
          "esm"
        ],
        "assets": [
          {
            "glob": "libs/onus-core/README.md",
            "input": ".",
            "output": "."
          }
        ]
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "npx semantic-release --extends ./libs/onus-core/release.config.js ",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx}",
          "libs/onus-core/package.json"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit"
        ],
        "cwd": "{projectRoot}",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/onus-core/jest.config.ts"
      }
    }
  }
}
